# 依赖文件
node_modules/
vendor/
.m2repo/

# 音频文件
*.mp3
*.wav
*.ogg

# 图片文件（如果不是必要的）
*.webp
*.jpg
*.jpeg
*.png
*.gif

# Frontend runtime assets must be versioned for reproducible Docker builds.
!gobang-frontend/public/**

# 日志文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 系统文件
.DS_Store
Thumbs.db

# IDE文件
.vscode/
.idea/
*.swp
*.swo

# 临时文件
tmp/
temp/
*.tmp

# 构建文件
dist/
build/
target/
*.exe

# 环境变量
.env
.env.local

# Local database exports contain account data; never commit them.
/backups/
