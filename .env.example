# Copy this file to .env for the Docker development environment.
# Do not commit the real .env file.
COMPOSE_PROJECT_NAME=gobang

# Default: docker.io. In restricted networks, a trusted Docker Hub mirror can be used.
IMAGE_REGISTRY=docker.io

# Host ports. Services only bind to 127.0.0.1 by default.
FRONTEND_PORT=5173
BACKEND_PORT=8080
MYSQL_PORT=3307

MYSQL_DATABASE=gobang_db
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password

DB_USERNAME=gobang
DB_PASSWORD=change-me

# Keep this origin aligned with FRONTEND_PORT when using direct backend access.
CORS_ALLOWED_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=false
APP_LOG_LEVEL=INFO
FLYWAY_BASELINE_ON_MIGRATE=false

# Compose injects a mysql:3306 JDBC URL into the backend container automatically.
# For a host-run backend, set DB_URL in your IDE or terminal instead:
# DB_URL=jdbc:mysql://localhost:3307/gobang_db?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true

# Optional: only needed by the legacy start.bat when mysql is not on PATH.
MYSQL_BIN=D:\path\to\mysql\bin
